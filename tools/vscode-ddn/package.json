{
  "name": "ddn-language",
  "displayName": "Ddonilang (ddn)",
  "description": "Ddonilang language registration, syntax highlighting, and local stdio LSP client",
  "version": "0.0.1",
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:ddonilang",
    "onCommand:ddonilang.selectLanguageServerExecutable",
    "onCommand:ddonilang.showLanguageServerStatus",
    "onCommand:ddonilang.restartLanguageServer",
    "onCommand:ddonilang.runCurrentDocumentConsoleBogae"
  ],
  "publisher": "ddonilang",
  "engines": {
    "vscode": "^1.70.0"
  },
  "categories": [
    "Languages"
  ],
  "contributes": {
    "languages": [
      {
        "id": "ddonilang",
        "aliases": [
          "DDN",
          "ddn",
          "Ddonilang",
          "또니랑"
        ],
        "extensions": [
          ".ddn",
          ".또니",
          ".ddl",
          ".옮김"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "ddonilang",
        "scopeName": "source.ddn",
        "path": "./syntaxes/ddn.tmLanguage.json"
      }
    ],
    "semanticTokenScopes": [
      {
        "language": "ddonilang",
        "scopes": {
          "function": ["entity.name.function.ddn", "entity.name.function.call.ddn"],
          "type": ["storage.type.ddn", "entity.name.type.ddn"],
          "variable": ["variable.other.ddn"],
          "parameter": ["variable.parameter.ddn"],
          "keyword": ["keyword.control.ddn"],
          "string": ["string.quoted.double.ddn"],
          "number": ["constant.numeric.ddn"],
          "operator": ["keyword.operator.ddn"],
          "atom": ["constant.other.ddn"],
          "josa": ["keyword.other.josa.ddn"]
        }
      }
    ],
    "themes": [
      {
        "label": "Ddonilang Readable",
        "uiTheme": "vs-dark",
        "path": "./themes/ddonilang-readable-color-theme.json"
      }
    ],
    "commands": [
      {
        "command": "ddonilang.selectLanguageServerExecutable",
        "title": "Ddonilang: Select Language Server Executable"
      },
      {
        "command": "ddonilang.showLanguageServerStatus",
        "title": "Ddonilang: Show Language Server Status"
      },
      {
        "command": "ddonilang.restartLanguageServer",
        "title": "Ddonilang: Restart Language Server"
      },
      {
        "command": "ddonilang.runCurrentDocumentConsoleBogae",
        "title": "Ddonilang: Run Current Document Console 보개"
      }
    ],
    "snippets": [
      {
        "language": "ddonilang",
        "path": "./snippets/ddn.code-snippets"
      }
    ],
    "configuration": {
      "title": "Ddonilang",
      "properties": {
        "ddonilang.lsp.executable": {
          "type": "string",
          "default": "",
          "description": "Exact local path to ddonirang-lsp. Used by the future stdio client; empty means bounded local discovery."
        },
        "ddonilang.lsp.autoDiscover": {
          "type": "boolean",
          "default": true,
          "description": "Allow bounded local discovery of a Cargo-built ddonirang-lsp executable."
        },
        "ddonilang.runtime.executable": {
          "type": "string",
          "default": "",
          "description": "Exact local path to the approved ddonilang runtime executable."
        },
        "ddonilang.runtime.autoDiscover": {
          "type": "boolean",
          "default": true,
          "description": "Allow bounded discovery of the approved local ddonilang runtime executable."
        }
      }
    }
  },
  "scripts": {
    "test": "node test/extension.test.js && node test/activation.test.js && node test/console-bogae.test.js && node test/readability.test.js && node test/package-inventory.js",
    "package:inventory": "node test/package-inventory.js"
  },
  "dependencies": {
    "vscode-languageclient": "8.1.0"
  },
  "devDependencies": {
    "@vscode/vsce": "3.9.2"
  }
}
