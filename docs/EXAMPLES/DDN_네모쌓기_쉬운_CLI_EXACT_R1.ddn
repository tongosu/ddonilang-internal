왼쪽높이 <- 0.
가운데높이 <- 0.
오른쪽높이 <- 0.
차례 <- 0.
{ 차례 < 5 }인것 동안 {
  만약 차례 == 0 이라면 {
    왼쪽높이 <- 왼쪽높이 + 1.
  }.
  만약 차례 == 1 이라면 {
    가운데높이 <- 가운데높이 + 1.
  }.
  만약 차례 == 2 이라면 {
    가운데높이 <- 가운데높이 + 1.
  }.
  만약 차례 == 3 이라면 {
    오른쪽높이 <- 오른쪽높이 + 1.
  }.
  만약 차례 == 4 이라면 {
    가운데높이 <- 가운데높이 + 1.
  }.
  차례 <- 차례 + 1.
}.
점수 <- (왼쪽높이 + 가운데높이 + 오른쪽높이) * 10.
"왼쪽 높이" 보여주기.
왼쪽높이 보여주기.
"가운데 높이" 보여주기.
가운데높이 보여주기.
"오른쪽 높이" 보여주기.
오른쪽높이 보여주기.
"점수" 보여주기.
점수 보여주기.
