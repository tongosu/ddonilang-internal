{
  "schema": "ddn.diag_three_layer.beginner_dictionary.draft.v1",
  "date": "2026-07-07",
  "status": "draft_only",
  "closure_claim": false,
  "entries": [
    {
      "code": "E_BLOCK_HEADER_COLON_FORBIDDEN",
      "what": "블록 머리말에 이제 쓰지 않는 콜론 표기가 있습니다.",
      "where": "진단 span의 파일, 줄, 열을 표시합니다.",
      "how": "콜론을 지우고 `채비 {`처럼 공백 뒤에 `{`를 씁니다."
    },
    {
      "code": "E_CANON_MAEGIM_GROUPED_VALUE_REQUIRED",
      "what": "`매김` 값이 묶음값 형태로 완성되지 않았습니다.",
      "where": "문제가 난 `매김` 줄과 값 시작 위치를 표시합니다.",
      "how": "값을 괄호나 값꾸러미 형태로 묶어 하나의 값으로 만듭니다."
    },
    {
      "code": "E_PARSE_EXPECTED_RBRACE",
      "what": "열린 블록을 닫는 `}`가 빠졌습니다.",
      "where": "파서가 블록 끝을 기대한 줄을 표시합니다.",
      "how": "해당 블록의 마지막에 `}`를 추가합니다."
    },
    {
      "code": "E_PARSE_EXPECTED_RPAREN",
      "what": "열린 괄호를 닫는 `)`가 빠졌습니다.",
      "where": "파서가 괄호 끝을 기대한 줄을 표시합니다.",
      "how": "해당 식이나 호출의 마지막에 `)`를 추가합니다."
    },
    {
      "code": "E_PARSE_MAEGIM_GROUPED_VALUE_REQUIRED",
      "what": "`매김` 안의 값이 하나의 묶음으로 읽히지 않습니다.",
      "where": "문제가 난 `매김` 항목 위치를 표시합니다.",
      "how": "관련 값을 괄호로 묶거나 한 값꾸러미로 정리합니다."
    },
    {
      "code": "E_EXEC_ENUM_INVALID",
      "what": "실행 정책 값이 허용 목록에 없습니다.",
      "where": "잘못 쓴 실행 정책 값 위치를 표시합니다.",
      "how": "진단에 표시된 허용값 중 하나로 바꿉니다."
    },
    {
      "code": "E_EXEC_POLICY_DUPLICATE",
      "what": "같은 실행 정책을 두 번 선언했습니다.",
      "where": "중복된 정책 선언 위치를 표시합니다.",
      "how": "하나만 남기고 나머지 선언을 지웁니다."
    },
    {
      "code": "E_EFFECT_IN_STRICT_MODE",
      "what": "strict 실행에서는 외부 효과를 바로 실행할 수 없습니다.",
      "where": "금지된 효과 호출 위치를 표시합니다.",
      "how": "효과를 기록/허용 정책 경로로 옮기거나 strict가 아닌 모드에서 실행합니다."
    },
    {
      "code": "E_EFFECT_IN_ISOLATED_MODE",
      "what": "격리 실행에서는 외부 효과를 사용할 수 없습니다.",
      "where": "격리 실행에서 발견된 효과 호출 위치를 표시합니다.",
      "how": "외부 효과가 없는 입력으로 바꾸거나 별도 허용 실행으로 분리합니다."
    },
    {
      "code": "E_EFFECT_SURFACE_ALIAS_FORBIDDEN",
      "what": "효과 표면에 더 이상 쓰지 않는 별칭이 있습니다.",
      "where": "별칭이 나온 위치를 표시합니다.",
      "how": "현재 정본 효과 표면으로 바꿉니다."
    },
    {
      "code": "E_OPEN_DENIED",
      "what": "허용되지 않은 파일이나 외부 자원에 접근하려 했습니다.",
      "where": "막힌 접근 요청 위치와 경로를 표시합니다.",
      "how": "허용 정책에 경로를 추가하거나 접근을 제거합니다."
    },
    {
      "code": "E_OPEN_IO",
      "what": "파일 또는 외부 자원을 읽고 쓰는 중 문제가 생겼습니다.",
      "where": "실패한 경로와 호출 위치를 표시합니다.",
      "how": "경로가 맞는지, 파일이 있는지, 권한이 맞는지 확인합니다."
    },
    {
      "code": "E_OPEN_LOG_MISSING",
      "what": "재연에 필요한 기록 파일이 없습니다.",
      "where": "찾으려던 기록 파일 경로를 표시합니다.",
      "how": "먼저 기록 모드로 실행해 log를 만들거나 올바른 log 경로를 지정합니다."
    },
    {
      "code": "E_OPEN_LOG_PARSE",
      "what": "재연 기록 파일을 읽을 수 없는 형식입니다.",
      "where": "문제가 난 log 줄이나 파일 위치를 표시합니다.",
      "how": "log를 다시 만들거나 손상된 줄을 제거합니다."
    },
    {
      "code": "E_OPEN_LOG_TAMPER",
      "what": "재연 기록이 현재 입력과 맞지 않습니다.",
      "where": "불일치가 난 기록 항목을 표시합니다.",
      "how": "입력이 바뀌었다면 새로 기록하고, 아니라면 log 손상을 확인합니다."
    },
    {
      "code": "E_OPEN_REPLAY_MISS",
      "what": "재연 중 필요한 외부 입력 기록을 찾지 못했습니다.",
      "where": "누락된 replay 항목과 호출 위치를 표시합니다.",
      "how": "같은 입력으로 record를 다시 만들거나 누락된 항목을 포함한 log를 사용합니다."
    },
    {
      "code": "E_GUSEONG_INSTANCE_DUP",
      "what": "같은 구성요소 이름이 두 번 선언되었습니다.",
      "where": "중복된 두 선언 위치를 표시합니다.",
      "how": "둘 중 하나의 이름을 바꾸거나 중복 선언을 지웁니다."
    },
    {
      "code": "E_GUSEONG_INSTANCE_UNDECLARED",
      "what": "선언하지 않은 구성요소를 사용했습니다.",
      "where": "없는 구성요소를 참조한 위치를 표시합니다.",
      "how": "먼저 구성요소를 선언하거나 참조 이름을 기존 이름으로 고칩니다."
    },
    {
      "code": "E_GUSEONG_LINK_CYCLE",
      "what": "구성요소 연결이 자기 자신으로 되돌아오는 순환을 만들었습니다.",
      "where": "순환에 포함된 연결을 표시합니다.",
      "how": "순환을 만드는 연결 하나를 끊거나 중간 상태를 명시합니다."
    },
    {
      "code": "E_PARSE_CALL_JOSA_AMBIGUOUS",
      "what": "조사만으로는 어느 값이 어느 핀에 들어가는지 정할 수 없습니다.",
      "where": "애매한 호출의 값과 조사 위치를 표시합니다.",
      "how": "`값:핀`처럼 핀 이름을 함께 써서 뜻을 고정합니다."
    }
  ]
}
