{
  "schema": "seamgrim.wave3b.foundation12.view_plan.contract.v1",
  "world_count": 12,
  "view_plan_schema": "seamgrim.view_plan.v1",
  "runtime_route": "tab=studio&lesson=<lesson_id>",
  "required_static_evidence": [
    "view_plan_path in lesson meta",
    "primary_view_target",
    "at least two required anchors",
    "anchor unit",
    "anchor accessibility_name",
    "anchor provenance path and source_span",
    "hash_policy.state_hash_participation=false"
  ],
  "required_browser_evidence": [
    "viewPlanRuntime=1",
    "semanticCursorRuntime=1",
    "anchor source provenance available",
    "view_plan_hash candidate emitted",
    "primary view nonblank at 1440x900, 1280x800, 1024x768, 390x844"
  ],
  "behavior_closed_claim": true,
  "new_ddn_syntax": false,
  "state_hash_formula_change": false,
  "world_state_view_storage": false,
  "docs_ssot_edit": false
}
