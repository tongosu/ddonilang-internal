{
  "schema": "ddn.pack.contract.v1",
  "pack": "seamgrim_portable_project_artifact_v1",
  "gate": "G1",
  "portable_schema": "seamgrim.project_snapshot_artifact.v0",
  "new_stable_schema": false,
  "max_bytes": 2000000,
  "capability_export_allowed": false,
  "authorization_export_allowed": false,
  "auto_run_on_import": false,
  "new_ddn_syntax": false,
  "state_hash_formula_change": false,
  "browser_runner": "tests/seamgrim_portable_project_artifact_runner.mjs",
  "checker": "tests/run_seamgrim_portable_project_artifact_check.py",
  "negative_controls": [
    "wrong_wrapper_schema",
    "wrong_snapshot_schema",
    "canonical_json_mismatch",
    "sha256_mismatch",
    "oversize_file",
    "forbidden_capability",
    "prototype_pollution_key",
    "invalid_utf8",
    "invalid_json"
  ]
}

