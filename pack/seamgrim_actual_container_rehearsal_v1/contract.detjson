    "install_without_approval_allowed": false,
    "image_pull_without_approval_allowed": false,
    "required_install_approval_env": "CONTAINER_RUNTIME_INSTALL_APPROVED",
    "required_pull_approval_env": "CONTAINER_IMAGE_PULL_APPROVED"
  },
  "static_inputs": {
    "dockerfile": "solutions/seamgrim_ui_mvp/deploy/Dockerfile",
    "compose": "solutions/seamgrim_ui_mvp/deploy/docker-compose.yml",
