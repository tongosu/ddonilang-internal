    "g5_readiness_checker": "tests/run_seamgrim_actual_container_readiness_check.py",
    "g9_storage_error_hardening_checker": "tests/run_seamgrim_storage_error_hardening_check.py",
    "g10_local_backup_restore_rollback_checker": "tests/run_seamgrim_local_backup_restore_rollback_rehearsal_check.py",
    "g11_actual_container_rehearsal_checker": "tests/run_seamgrim_actual_container_rehearsal_check.py"
  },
