{
  "schema": "seamgrim.foundation12.cli_raw_wasm_parity.contract.v1",
  "goal": "CODEX_SUPERLONG_GOAL_DDN_CLI_WASM_SINGLE_RUNTIME_CLOSURE_V1_20260712 G6",
  "lesson_ids": [
