# Seamgrim private-pilot compose environment template.
# Replace every example value outside the repository. Do not commit secrets here.

SEAMGRIM_PROJECT_DATA_DIR=/srv/seamgrim/private-pilot/data
SEAMGRIM_BACKUP_STAGING_DIR=/srv/seamgrim/private-pilot/backup-staging
SEAMGRIM_LOG_DIR=/var/log/seamgrim-private-pilot
SEAMGRIM_RELEASE_COMMIT=REPLACE_WITH_SEALED_RELEASE_COMMIT
SEAMGRIM_RELEASE_MANIFEST_SHA256=REPLACE_WITH_SEALED_RELEASE_MANIFEST_SHA256

SEAMGRIM_ALLOWED_HOSTS=seamgrim.private.example.invalid
SEAMGRIM_ALLOWED_ORIGINS=https://seamgrim.private.example.invalid
SEAMGRIM_PUBLIC_BASE_URL=https://seamgrim.private.example.invalid
SEAMGRIM_TRUSTED_PROXY_POLICY=private-edge

# Required when the local Python sqlite3 runtime is below the pinned pilot floor.
# The operator must confirm local filesystem, WAL safety, and distro/backport basis.
SEAMGRIM_SQLITE_WAL_SAFETY_ATTESTATION=REPLACE_WITH_OPERATOR_ATTESTATION

TEUL_CLI_WORKER=0
