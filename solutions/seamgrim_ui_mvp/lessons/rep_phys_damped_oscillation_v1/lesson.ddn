설정 {
  제목: "감쇠 진동".
  설명: "감쇠계수와 스프링 상수를 바꾸며 진폭이 줄어드는 x(t) 그래프를 봅니다.".
  마디수: 4001.
}.

채비 {
  질량: 수 <- (1.0) 매김 { 범위: 0.5..4.0. 간격: 0.1. }.
  스프링상수: 수 <- (4.0) 매김 { 범위: 0.5..12.0. 간격: 0.1. }.
  감쇠계수: 수 <- (0.5) 매김 { 범위: 0.0..3.0. 간격: 0.05. }.
  dt: 수 <- (0.02) 매김 { 범위: 0.005..0.08. 간격: 0.005. }.
  t_max: 수 <- (12.0) 매김 { 범위: 3.0..20.0. 간격: 0.5. }.
}.

(시작)할때 {
  t <- 0.
  x <- 1.
  v <- 0.
  에너지손실 <- 0.
}.

(매마디)마다 {
  { t <= t_max }인것 일때 {
    운동에너지 <- 0.5 * 질량 * v * v.
    탄성에너지 <- 0.5 * 스프링상수 * x * x.
    총에너지 <- 운동에너지 + 탄성에너지.

    보임 {
      t: t.
      x: x.
      v: v.
      감쇠계수: 감쇠계수.
      총에너지: 총에너지.
      에너지손실: 에너지손실.
    }.

    a <- (-(스프링상수*x) - (감쇠계수*v)) / 질량.
    v <- v + (a*dt).
    x <- x + (v*dt).
    에너지손실 <- 에너지손실 + 감쇠계수 * v * v * dt.
    t <- t + dt.
  }.
}.
