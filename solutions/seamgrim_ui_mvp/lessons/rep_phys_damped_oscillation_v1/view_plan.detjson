        "path": "solutions/seamgrim_ui_mvp/lessons/rep_phys_damped_oscillation_v1/lesson.ddn",
        "source_span": "x <- x + (v*dt)"
      },
      "accessibility_name": "Damped oscillation displacement observation"
    },
    {
      "anchor_id": "obs.velocity",
      "source_ref": {
        "kind": "observation",
        "key": "v"
      },
      "value_type": "scalar",
