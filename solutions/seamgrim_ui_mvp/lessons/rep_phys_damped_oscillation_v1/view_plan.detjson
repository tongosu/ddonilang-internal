        "path": "solutions/seamgrim_ui_mvp/lessons/rep_phys_damped_oscillation_v1/lesson.ddn",
        "source_span": "t <- t + dt"
      },
      "accessibility_name": "Damped oscillation time observation"
    },
    {
      "anchor_id": "obs.displacement",
      "source_ref": {
        "kind": "observation",
        "key": "x"
      },
      "value_type": "scalar",
      "unit": "m",
      "label": "변위",
      "graph_key": "x",
