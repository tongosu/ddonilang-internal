        "path": "solutions/seamgrim_ui_mvp/lessons/rep_phys_damped_oscillation_v1/lesson.ddn",
        "source_span": "v <- v + (a*dt)"
      },
      "accessibility_name": "Damped oscillation velocity observation"
    },
    {
      "anchor_id": "obs.total_energy",
      "source_ref": {
        "kind": "observation",
        "key": "총에너지"
      },
      "value_type": "scalar",
      "unit": "J",
      "label": "총에너지",
      "graph_key": "총에너지",
      "provenance": {
        "path": "solutions/seamgrim_ui_mvp/lessons/rep_phys_damped_oscillation_v1/lesson.ddn",
        "source_span": "총에너지 <- 운동에너지 + 탄성에너지"
      },
      "accessibility_name": "Damped oscillation total energy observation"
    },
    {
      "anchor_id": "obs.energy_loss",
      "source_ref": {
        "kind": "observation",
        "key": "에너지손실"
      },
      "value_type": "scalar",
      "unit": "J",
      "label": "누적 에너지 손실",
      "graph_key": "에너지손실",
      "provenance": {
        "path": "solutions/seamgrim_ui_mvp/lessons/rep_phys_damped_oscillation_v1/lesson.ddn",
        "source_span": "에너지손실 <- 에너지손실 + 감쇠계수 * v * v * dt"
      },
      "accessibility_name": "Damped oscillation energy loss observation"
    }
