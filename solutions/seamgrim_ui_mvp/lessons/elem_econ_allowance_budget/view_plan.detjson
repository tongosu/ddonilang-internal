  "anchors": [
    {"anchor_id": "obs.time", "source_ref": {"kind": "observation", "key": "t"}, "value_type": "scalar", "unit": "month", "label": "마디", "accessibility_name": "예산 흐름 마디", "provenance": {"path": "solutions/seamgrim_ui_mvp/lessons/elem_econ_allowance_budget/lesson.ddn", "source_span": "t <- t + 1"}},
    {"anchor_id": "obs.balance", "source_ref": {"kind": "observation", "key": "잔액"}, "value_type": "scalar", "unit": "원", "label": "잔액", "accessibility_name": "현재 잔액", "provenance": {"path": "solutions/seamgrim_ui_mvp/lessons/elem_econ_allowance_budget/lesson.ddn", "source_span": "잔액 <- 잔액 + 순증감"}},
    {"anchor_id": "obs.saving", "source_ref": {"kind": "observation", "key": "누적저축"}, "value_type": "scalar", "unit": "원", "label": "누적저축", "accessibility_name": "누적 저축", "provenance": {"path": "solutions/seamgrim_ui_mvp/lessons/elem_econ_allowance_budget/lesson.ddn", "source_span": "누적저축 <- 누적저축 + 저축증가"}},
    {"anchor_id": "obs.spending", "source_ref": {"kind": "observation", "key": "누적지출"}, "value_type": "scalar", "unit": "원", "label": "누적지출", "accessibility_name": "누적 지출", "provenance": {"path": "solutions/seamgrim_ui_mvp/lessons/elem_econ_allowance_budget/lesson.ddn", "source_span": "누적지출 <- 누적지출 + 지출"}}
  ],
  "measures": [],
  "graph_cursor": {"cursor_id": "graph.current.balance", "x_anchor": "obs.time", "y_anchor": "obs.balance", "series_id": "잔액", "label": "현재 잔액"},
