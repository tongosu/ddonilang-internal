{
  "schema": "seamgrim.view_plan.v1",
  "lesson_id": "rep_econ_supply_demand_tax_v1",
  "binding_mode": "explicit",
  "runtime_surface": "ddn.original.product_frontdoor",
  "primary_view_target": "graph",
  "required_anchor_ids": ["obs.time", "obs.price", "obs.quantity", "obs.excess_demand"],
  "anchors": [
    {"anchor_id": "obs.time", "source_ref": {"kind": "observation", "key": "t"}, "value_type": "scalar", "unit": "tick", "label": "마디", "accessibility_name": "시장 조정 마디", "provenance": {"path": "solutions/seamgrim_ui_mvp/lessons/rep_econ_supply_demand_tax_v1/lesson.ddn", "source_span": "t <- t + 1"}},
    {"anchor_id": "obs.price", "source_ref": {"kind": "observation", "key": "가격"}, "value_type": "scalar", "unit": "원", "label": "가격", "accessibility_name": "시장 가격", "provenance": {"path": "solutions/seamgrim_ui_mvp/lessons/rep_econ_supply_demand_tax_v1/lesson.ddn", "source_span": "가격 <- 가격 + 0.2 * 초과수요"}},
    {"anchor_id": "obs.quantity", "source_ref": {"kind": "observation", "key": "거래량"}, "value_type": "scalar", "unit": "개", "label": "거래량", "accessibility_name": "시장 거래량", "provenance": {"path": "solutions/seamgrim_ui_mvp/lessons/rep_econ_supply_demand_tax_v1/lesson.ddn", "source_span": "거래량 <- 수요량"}},
    {"anchor_id": "obs.excess_demand", "source_ref": {"kind": "observation", "key": "초과수요"}, "value_type": "scalar", "unit": "개", "label": "초과수요", "accessibility_name": "수요와 공급의 차이", "provenance": {"path": "solutions/seamgrim_ui_mvp/lessons/rep_econ_supply_demand_tax_v1/lesson.ddn", "source_span": "초과수요 <- 수요량 - 공급량"}}
  ],
  "measures": [],
  "graph_cursor": {"cursor_id": "graph.current.price", "x_anchor": "obs.time", "y_anchor": "obs.price", "series_id": "가격", "label": "현재 가격"},
  "hash_policy": {"state_hash_participation": false, "view_plan_hash_candidate": true, "world_draw_payload_hash_candidate_uses_world_coordinates": true, "canonical_bogae_hash_claim": false}
