// stateful-sim preview(auto): range sampler -> step sim

채비 {
  시작x: 수 <- (-3.0) 매김 { 범위: -10..0. 간격: 0.5. }.
  끝x: 수 <- (3.0) 매김 { 범위: 0..10. 간격: 0.5. }.
  간격: 수 <- (0.5) 매김 { 범위: 0.25..2. 간격: 0.25. }.
}.

(시작)할때 {
  x <- 시작x.
}.

(매마디)마다 {
  // 함수: y = x^3 - 3x

  { x <= 끝x }인것 일때 {
    y <- x * x * x - 3 * x.
    보임 {
      x: x.
      y: y.
    }.
    x <- x + 간격.
  }.
}.
