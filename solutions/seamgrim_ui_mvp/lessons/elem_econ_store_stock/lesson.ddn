#기본관찰x: t
#기본관찰: 재고

채비 {
  초기재고: 수 <- (40.0) 매김 { 범위: 10..200. 간격: 5. }.
  주문점: 수 <- (12.0) 매김 { 범위: 0..80. 간격: 1. }.
  보충량: 수 <- (30.0) 매김 { 범위: 5..120. 간격: 5. }.
  리드마디: 수 <- (2.0) 매김 { 범위: 0..10. 간격: 1. }.
  기본수요: 수 <- (6.0) 매김 { 범위: 1..30. 간격: 1. }.
  수요증가: 수 <- (0.5) 매김 { 범위: 0..3. 간격: 0.1. }.
  최대마디: 수 <- (30.0) 매김 { 범위: 6..80. 간격: 1. }.
}.

(시작)할때 {
  t <- 0.
  재고 <- 초기재고.
  대기마디 <- 0.
  입고예정 <- 0.
}.

(매마디)마다 {
  { t < 최대마디 }인것 일때 {
    수요 <- 기본수요 + 수요증가 * t.
    판매 <- 수요.
    { 판매 > 재고 }인것 일때 {
      판매 <- 재고.
    }.
    재고 <- 재고 - 판매.

    발주 <- 0.
    보충 <- 0.

    { 대기마디 > 0 }인것 일때 {
      대기마디 <- 대기마디 - 1.
    }.
    { 대기마디 <= 0 }인것 일때 {
      { 입고예정 > 0 }인것 일때 {
        보충 <- 입고예정.
        재고 <- 재고 + 보충.
        입고예정 <- 0.
      }.
    }.

    { 재고 <= 주문점 }인것 일때 {
      { 입고예정 <= 0 }인것 일때 {
        발주 <- 보충량.
        입고예정 <- 보충량.
        대기마디 <- 리드마디.
      }.
    }.

    보임 {
      t: t.
      수요: 수요.
      판매: 판매.
      재고: 재고.
      발주: 발주.
      보충: 보충.
      대기마디: 대기마디.
    }.

    t <- t + 1.
  }.
}.
