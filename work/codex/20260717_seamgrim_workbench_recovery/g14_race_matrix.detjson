  "claim_level": "behavior-closed",
  "goal": {
    "summary": "Close the Seamgrim Workbench attack/order/race matrix with actual product browser paths and injected negative controls.",
    "required_negative_controls": [
      "run double-click creates one loop/run",
      "pause/resume spam creates no duplicate step",
      "stale callback after stop creates no additional commit",
      "project switch during live does not leak old callbacks into the new project",
      "source edit during live keeps the active sealed run immutable",
      "import/reopen during live follows explicit cancel/clear transition rules",
      "server checkpoint delay/failure does not duplicate world steps",
      "archive finalize retry finalizes once",
      "stale WASM manifest fails freshness",
      "string/comment tick surface is not misclassified as live",
      "legacy selected_view tamper does not change world state",
      "overlay/magnifier visibility changes do not change runtime state hash"
    ]
  },
  "implementation": {
    "product_changes": [
      "Expanded the Workbench debug snapshot with sealed run source_hash, source_kind, execution_mode, and server_archive_status so browser gates can assert race boundaries without inferring from UI text."
    ],
    "test_changes": [
      "Added tests/seamgrim_workbench_race_matrix_runner.mjs for actual server-backed Chromium race coverage.",
      "Added tests/run_seamgrim_workbench_race_matrix_check.py to validate runner output, freshness negative controls, and docs/ssot cleanliness."
    ]
  },
