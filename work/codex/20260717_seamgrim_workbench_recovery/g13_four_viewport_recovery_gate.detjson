  "goal": {
    "summary": "Close the Seamgrim Workbench product quality gate across 1440x900, 1024x768, 778x912, and 390x844 browser viewports.",
    "required_contracts": [
      "DDN source and primary view remain reachable",
      "first-screen management-only inputs are absent",
      "unrelated project controls are absent",
      "canvas dimensions are positive",
      "canvas is nonblank and changes with time",
      "side open/close refits primary view",
      "overlay moves with primary coordinates",
      "magnifier is gated before target selection",
      "horizontal overflow is absent",
      "incoherent button/label overlap is absent",
      "console errors and key warnings are absent"
    ]
  },
  "implementation": {
    "product_changes": [
      "Capped the compact viewport project list with internal scrolling.",
      "Made setup controls span the full control grid.",
      "Kept tablet controls compact with a four-column grid and smaller input/card spacing.",
      "Reordered mobile sections so run strip, file tabs, and workbench layout precede the control grid."
    ],
    "test_changes": [
      "Added a four-viewport Playwright browser gate runner.",
      "Added a Python wrapper that validates the runner, output summary, screenshots, canvas evidence, browser issues, and SSOT cleanliness."
    ]
  },
