정확한방법 <- (방식: "ddn.exact_acyclic_relation.v1").

계산 = 모형 {
  입력:나눔수@m :: (들임, 내줌).
  중간:나눔수@m :: (그자리, 내줌).
  결과:나눔수@m :: (그자리, 내줌).

  중간::구함.
  결과::구함.

  입력 + 1@m =:= 중간.
  결과 =:= 중간 * 2.
}.

실행결과 <- (
  대상=계산,
  들임=(입력: 2@m),
  방법=정확한방법,
  내줌=(결과, 입력, 중간)
) 풀기.

(
  계산값: 실행결과.결과,
  입력값: 실행결과.입력,
  중간값: 실행결과.중간
) 보임.
